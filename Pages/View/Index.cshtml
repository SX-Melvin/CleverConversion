@page
@model CleverConversion.Pages.View.IndexModel
@{
    ViewData["Title"] = "Loading...";
}

<style>
    .loader-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }
</style>

<div>
    <div class="loader-container">
        <div class="loader"></div>
    </div>
</div>

<script>
    async function getFileInfo() {
        try {
        const response = await fetch("@Model.BasePath/api/view/v1/node/@Model.NodeId/name/@Model.FileName");

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const json = await response.json();

        if(json.data.redirectLink != null) {
            window.location = json.data.redirectLink;
        } else if(json.data.relativePath != null) {
            window.location = `@Model.BasePath/viewer/?file=${json.data.relativePath}`
        }

        } catch (err) {
            console.error("Fetch error:", err);
        }
    }

    getFileInfo();
</script>
